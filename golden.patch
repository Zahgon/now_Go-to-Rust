+#[test]
+fn test_between() {
+    let _guard = setup();
+
+    let tm = Time::new(2015, 6, 30, 17, 51, 49, 123456789, &Location::local());
+    assert!(
+        now::with(tm.clone()).between("23:28:9 Dec 19, 2013 PST", "23:28:9 Dec 19, 2015 PST"),
+        "Between"
+    );
+
+    assert!(
+        now::with(tm).between("2015-05-12 12:20", "2015-06-30 17:51:50"),
+        "Between"
+    );
+}
